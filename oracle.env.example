# MagicPaper input-side configuration. Model providers and Pi are configured
# in ReMagic; never put a model API key in this file.
#
# ReMagic makes this file available to the managed application. Legacy bundles
# may still keep oracle.env next to the binary for OCR migration only.

# --- optional separate handwriting OCR ---
# With a token set, PP-OCRv6 reads the PNG first. Pi Agent receives the OCR
# candidate as untrusted text and corrects it with dialogue and language context.
# Keep this token private and rotate it if it is ever pasted into a chat/log.
# MAGICPAPER_OCR_TOKEN=your-aistudio-access-token
# MAGICPAPER_OCR_PROVIDER=paddle
# MAGICPAPER_OCR_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# MAGICPAPER_OCR_MODEL=PP-OCRv6
# MAGICPAPER_OCR_POLL_MS=250
# MAGICPAPER_OCR_TIMEOUT_SECONDS=60
# Enabled by default for lower latency. Set off if avoiding possible duplicate
# paid jobs after a mid-writing pause matters more than the 1.8-second head start.
# MAGICPAPER_OCR_SPECULATIVE=off

# --- the diary's memory ---
# The diary remembers finished pages (your pen strokes, a transcription, and
# MP's reply) in /home/root/.local/share/magicpaper/memories, entirely on the tablet.
# Recent pages ride along with each request so MP can follow a conversation,
# and writing "show me…" conjures a past page back in your own hand.
# MAGICPAPER_MEMORY=off          # forget nothing more, remember nothing new
# MAGICPAPER_MEMORY_DIR=/home/root/.local/share/magicpaper/memories
# MAGICPAPER_MEMORY_TURNS=20     # recent pages MP carries as continuous dialogue
# MAGICPAPER_TZ_OFFSET=8         # hours from UTC, so memory dates read right

# --- MagicPaper recurring tasks ---
# Handwrite e.g. "任务 每五分钟讲一个黑暗冷笑话" to add a persistent task.
# MP schedules the exact nearest due time and calls the oracle only then.
# Tasks survive restarts under /home/root/.local/share/magicpaper/tasks.
# MAGICPAPER_TASKS=off
# MAGICPAPER_TASKS_DIR=/home/root/.local/share/magicpaper/tasks
# Unscheduled TODOs are separate and never trigger the oracle on their own.
# MAGICPAPER_TODOS=off
# MAGICPAPER_TODOS_DIR=/home/root/.local/share/magicpaper/todos
# Smart heartbeat calls the oracle only when a task is actually due. This is
# merely the retry delay after a due-task delivery failure.
# MAGICPAPER_HEARTBEAT_RETRY_SECONDS=30

# --- local handwriting fonts ---
# ReMagic normally stages custom fonts beside the managed application. This
# override is useful only when keeping fonts in another device directory.
# MAGICPAPER_FONT_DIR=/home/root/apps/magicpaper/current/payload/share/fonts
# MAGICPAPER_UI_FONT=/home/root/apps/magicpaper/current/payload/share/fonts/FZPingXianYaSong.ttf
# MAGICPAPER_PREFERENCES_DIR=/home/root/.local/share/magicpaper/preferences
# Handwrite 字体/字體 to select a font and calibrate each installed font from
# 50% to 180%. The tablet stores those values in the preferences directory.

# --- debugging ---
# Keep the committed page at /tmp/magicpaper-page.png after each turn instead of
# deleting it once PaddleOCR has read it. Handy with `magicpaper --ocr-test`.
# MAGICPAPER_KEEP_PAGE=1
