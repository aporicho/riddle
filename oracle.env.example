# Standalone install: copy this to /home/root/.config/riddle/oracle.env and
# fill in your key to use the HTTP oracle backend.
# The Remagic manifest provides this file to the managed application. Legacy
# compatibility bundles may still keep oracle.env next to the binary.
#
# Any OpenAI-compatible endpoint works when separate OCR is enabled; without
# it the answer model must be vision-capable. Responses mode additionally
# supports model-managed web search.

RIDDLE_OPENAI_KEY=sk-your-key-here

# --- optional separate handwriting OCR ---
# With a token set, PP-OCRv6 reads the PNG first. The OpenAI-compatible
# answer model receives only corrected candidate text, never the page image.
# Keep this token private and rotate it if it is ever pasted into a chat/log.
# RIDDLE_OCR_TOKEN=your-aistudio-access-token
# RIDDLE_OCR_PROVIDER=paddle
# RIDDLE_OCR_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# RIDDLE_OCR_MODEL=PP-OCRv6
# RIDDLE_OCR_POLL_MS=250
# RIDDLE_OCR_TIMEOUT_SECONDS=60
# Enabled by default for lower latency. Set off if avoiding possible duplicate
# paid jobs after a mid-writing pause matters more than the 1.8-second head start.
# RIDDLE_OCR_SPECULATIVE=off

# Optional — defaults shown:
# RIDDLE_OPENAI_BASE=https://api.openai.com/v1
# RIDDLE_OPENAI_MODEL=gpt-4o-mini
# RIDDLE_OPENAI_API=chat_completions

# Smart paper mode (OpenAI Responses-compatible providers):
# RIDDLE_OPENAI_MODEL=gpt-5.6-terra
# RIDDLE_OPENAI_API=responses
# RIDDLE_OPENAI_REASONING=low
# RIDDLE_WEB_SEARCH=auto
# RIDDLE_PAPER_REWRITE_MODEL=gpt-5.6-luna
# RIDDLE_IMAGE_MAX_EDGE=1600

# Runaway guard on the reply. Thinking models (Gemini 3.x, o-series…) count
# their hidden reasoning tokens against this, so keep it roomy — a tight cap
# cuts the visible reply down to a single sentence.
# RIDDLE_OPENAI_MAX_TOKENS=2000

# For reasoning models only. Responses sends reasoning.effort; legacy chat
# sends reasoning_effort. "low" keeps first ink fast.
# RIDDLE_OPENAI_REASONING=low

# Example: OpenRouter
# RIDDLE_OPENAI_BASE=https://openrouter.ai/api/v1
# RIDDLE_OPENAI_MODEL=openai/gpt-4o-mini

# Example: Gemini (OpenAI-compatible endpoint)
# RIDDLE_OPENAI_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# RIDDLE_OPENAI_MODEL=gemini-3.5-flash
# RIDDLE_OPENAI_REASONING=low

# --- pi backend (used only when RIDDLE_OPENAI_KEY is not set) ---
# Where pi lives and what it runs. Defaults shown. Note: pi keeps its own
# session history under its data dir; the HTTP backend keeps nothing.
# RIDDLE_PI_BIN_DIR=/home/root/node/bin
# RIDDLE_PI_PROVIDER=openai-codex
# RIDDLE_PI_MODEL=gpt-5.4-mini

# --- the diary's memory ---
# The diary remembers finished pages (your pen strokes, a transcription, and
# MP's reply) in /home/root/riddle-data/memories, entirely on the tablet.
# Recent pages ride along with each request so MP can follow a conversation,
# and writing "show me…" conjures a past page back in your own hand.
# RIDDLE_MEMORY=off          # forget nothing more, remember nothing new
# RIDDLE_MEMORY_DIR=/home/root/riddle-data/memories
# RIDDLE_MEMORY_TURNS=20     # recent pages MP carries as continuous dialogue
# RIDDLE_TZ_OFFSET=8         # hours from UTC, so memory dates read right

# --- MagicPaper recurring tasks ---
# Handwrite e.g. "任务 每五分钟讲一个黑暗冷笑话" to add a persistent task.
# MP schedules the exact nearest due time and calls the oracle only then.
# Tasks survive restarts under /home/root/riddle-data/tasks.
# RIDDLE_TASKS=off
# RIDDLE_TASKS_DIR=/home/root/riddle-data/tasks
# Unscheduled TODOs are separate and never trigger the oracle on their own.
# RIDDLE_TODOS=off
# RIDDLE_TODOS_DIR=/home/root/riddle-data/todos
# Smart heartbeat calls the oracle only when a task is actually due. This is
# merely the retry delay after a due-task delivery failure.
# RIDDLE_HEARTBEAT_RETRY_SECONDS=30

# --- local handwriting fonts ---
# Remagic normally stages custom fonts beside the managed application. This
# override is useful only when keeping fonts in another device directory.
# RIDDLE_FONT_DIR=/home/root/apps/remagic/opt/magicpaper/fonts
# RIDDLE_UI_FONT=/home/root/apps/remagic/opt/magicpaper/fonts/FZPingXianYaSong.ttf
# RIDDLE_PREFERENCES_DIR=/home/root/riddle-data/preferences
# Handwrite 字体/字體 to select a font and calibrate each installed font from
# 50% to 180%. The tablet stores those values in the preferences directory.

# --- debugging ---
# Keep the committed page at /tmp/riddle-page.png after each turn instead of
# deleting it once the oracle has read it. Handy with `riddle --oracle-test`.
# RIDDLE_KEEP_PAGE=1
