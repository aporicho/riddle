# Riddle standalone defaults. Add a vision-capable API key to enable replies:
# RIDDLE_OPENAI_KEY=sk-your-key-here
# RIDDLE_OPENAI_BASE=https://api.openai.com/v1
# RIDDLE_OPENAI_MODEL=gpt-4o-mini

RIDDLE_MEMORY_DIR=/home/root/riddle-data/memories
RIDDLE_MEMORY_TURNS=20
RIDDLE_TZ_OFFSET=8
RIDDLE_HEARTBEAT_RETRY_SECONDS=30
RIDDLE_IMAGE_MAX_EDGE=1600
# Setting RIDDLE_OCR_TOKEN enables fast PP-OCRv6 text recognition and stops
# sending page images to the answer model.
RIDDLE_OCR_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
RIDDLE_OCR_MODEL=PP-OCRv6
RIDDLE_OCR_POLL_MS=250
RIDDLE_OCR_TIMEOUT_SECONDS=60
RIDDLE_OCR_SPECULATIVE=on
