[Unit]
Description=MagicPaper triple-power-button launcher
After=home.mount systemd-udevd.service
ConditionPathExists=/home/root/apps/riddle/riddle

[Service]
Type=simple
Environment=HOME=/home/root
Environment=LD_LIBRARY_PATH=/home/root/apps/riddle:/home/root/quill:/usr/lib/plugins/scenegraph
ExecStart=/home/root/apps/riddle/riddle --power-launcher
Restart=always
RestartSec=2
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
