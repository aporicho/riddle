[Unit]
Description=MagicPaper full-screen living paper
After=home.mount
ConditionPathExists=/home/root/apps/riddle/riddle

[Service]
Type=simple
Environment=HOME=/home/root
Environment=RIDDLE_SYSTEMD_MANAGED=1
WorkingDirectory=/home/root/apps/riddle
ExecStart=/bin/bash /home/root/apps/riddle/riddle-takeover.sh
ExecStopPost=-/home/root/apps/riddle/riddle-restore.sh
KillMode=control-group
TimeoutStopSec=20
Restart=no
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
